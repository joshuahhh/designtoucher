@top Program { newlineSep<Call> }

Call { Command Arg* }
Command { Identifier }
Arg { Identifier | Number }

@tokens {
  Identifier { $[A-Za-z_] $[A-Za-z0-9_$]* }
  comment { "#" ![\n]* }

  Number { '-'? int frac? exp? }
  int { '0' | $[1-9] @digit* }
  frac { '.' @digit* }
  exp { $[eE] $[+\-]? @digit+ }

  whitespace { $[ \t]+ }
  newline { '\r'? '\n' }
}

@skip { whitespace | comment }

newlineSep<x> {
  (x newline | newline)* x?
}
